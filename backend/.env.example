# =============================================================================
# GrowFlow backend environment — copy to `.env` and fill in real values.
# All variables here are validated at boot by src/common/env.validation.ts.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=growflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=growflow

# --- Authentication ---
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-64-hex-char-string-at-minimum-32-chars
JWT_EXPIRES_IN=1d

# --- Networking ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:4000,http://localhost:3000

# Location of the companion Python sentiment-analysis service.
AI_SERVICE_URL=http://127.0.0.1:5002

# Flip to "false" to disable the /docs Swagger UI in production.
SWAGGER_ENABLED=true
