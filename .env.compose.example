# =============================================================================
# GrowFlow -- environment for `docker compose up`.
# Copy this file to `.env.compose` and fill in real values, then:
#
#   docker compose --env-file .env.compose up --build
#
# Or commit a non-secret subset and let secrets come from your shell.
# =============================================================================

# --- Database ---
POSTGRES_USER=growflow
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=growflow

# --- Backend auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-64-hex-char-string-at-minimum-32-chars
JWT_EXPIRES_IN=1d

# --- Networking ---
# What the FRONTEND container talks to. Use the host-mapped port.
NEXT_PUBLIC_API_URL=http://localhost:3000
# What origins the BACKEND will accept CORS from.
CORS_ORIGINS=http://localhost:4000

# --- Gemini (optional) ---
# Leave blank to fall back to deterministic / canned AI responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Admin endpoints (optional) ---
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Misc ---
SWAGGER_ENABLED=true
