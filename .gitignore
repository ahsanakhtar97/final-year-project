# Dependencies -- these must never be committed. Without this file the
# stray root-level node_modules/ ended up tracked in the repo.
node_modules/

# Build output
.next/
out/
dist/
build/

# Environment files (secrets)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/

# Editor & OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# TypeScript incremental build info
*.tsbuildinfo
